# AI Performance Coach - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# AI GATEWAY CONFIGURATION (Backend)
# ============================================================================

# LLM Provider: gemini, openai, nvidia-nim, qwen, deepseek
LLM_PROVIDER=gemini

# LLM API Key (from your provider)
# - Gemini: https://aistudio.google.com/apikey
# - OpenAI: https://platform.openai.com/api-keys
# - NVIDIA NIM: https://build.nvidia.com/
# - Qwen: https://dashscope.console.aliyun.com/
# - DeepSeek: https://platform.deepseek.com/
LLM_API_KEY=your-api-key-here

# LLM Model (must be in capability registry)
# Examples:
# - gemini-2.5-flash, gemini-2.0-flash
# - gpt-4o, gpt-4o-mini
# - deepseek-v4-pro, deepseek-v4-flash (via nvidia-nim)
# - meta/llama-3.1-405b-instruct (via nvidia-nim)
# - qwen/qwen2.5-72b-instruct (via nvidia-nim)
# - qwen-turbo, qwen-plus (direct)
# - deepseek-chat, deepseek-coder (direct)
LLM_MODEL=gemini-2.5-flash

# Optional: Custom base URL for OpenAI-compatible providers
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Force demo mode even if backend is available
VITE_USE_MOCK_AI=false

# Application name
VITE_APP_NAME=Performance Coach

# ============================================================================
# BACKWARD COMPATIBILITY (Legacy variables, still supported)
# ============================================================================

# Legacy Gemini variables (converted to LLM_* internally)
# GEMINI_API_KEY=
# GEMINI_MODEL=
